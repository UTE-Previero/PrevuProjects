<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Prevu.Synoptics"
			 xmlns:Machines="clr-namespace:Prevu.Drawings.Machines;assembly=Prevu.Drawings" 
             xmlns:Labels="clr-namespace:Prevu.UIComponents.Labels;assembly=Prevu.UIComponents" 
             x:Class="Prevu.Synoptics.D254" 
             mc:Ignorable="d" 
             
             d:Background="{DynamicResource MaterialDesignPaper}">
    <Canvas Height="212" Width="170">
        <Labels:Pipe Color="Water" Width="92" StatusComponent="254-44-FT1" Canvas.Left="-5" Canvas.Top="52" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Labels:Pipe.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="90"/>
                </TransformGroup>
            </Labels:Pipe.RenderTransform>
        </Labels:Pipe>
        <Labels:Pipe Color="Water" Width="68" StatusComponent="254-21-CV1" Canvas.Left="7" Canvas.Top="163" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Labels:Pipe.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="90"/>
                </TransformGroup>
            </Labels:Pipe.RenderTransform>
        </Labels:Pipe>
        <Machines:V01_CV_Valve Canvas.Left="19" Canvas.Top="105" Height="24" Width="46" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Machines:V01_CV_Valve.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="90"/>
                </TransformGroup>
            </Machines:V01_CV_Valve.RenderTransform>
        </Machines:V01_CV_Valve>
        <Rectangle Height="2" Stroke="Black" Width="28" RenderTransformOrigin="0.5,0.5" Canvas.Left="27" Canvas.Top="8" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Rectangle Height="2" Stroke="Black" Width="28" Canvas.Left="45" Canvas.Top="50" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Ellipse Height="16" Stroke="#FFBDBDBD" Width="16" OpacityMask="#FFBDBDBD" Fill="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}" Canvas.Left="33" Canvas.Top="43" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Labels:DeviceLabel ComponentName="254-21-CV1" Canvas.Left="59" Canvas.Top="92" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Labels:DeviceLabel ComponentName="254-44-FT1" Canvas.Left="59" Canvas.Top="26" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Rectangle Height="6" Stroke="Black" Width="36" Fill="#FFBDBDBD" RenderTransformOrigin="0.5,0.5" Canvas.Left="23" Canvas.Top="196" HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </Canvas>
</UserControl>
